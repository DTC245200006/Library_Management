      "title": "HTTP Requests Rate (Library App)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (route, status_code) (rate(library_http_requests_total[1m]))",
          "legendFormat": "{{route}} [{{status_code}}]"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
